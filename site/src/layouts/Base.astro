---
interface Props { title: string; description?: string; bodyClass?: string }
const { title, description = 'A documentary map of known serial killers worldwide, with sources for every fact.', bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap" rel="stylesheet" />
    <script is:inline>
      // tema înainte de randare, ca să nu clipească; localStorage poate lipsi (mod privat)
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --bg: #f5f4f1; --surface: #ffffff; --surface-2: #f0efeb; --fg: #1c1d21; --muted: #6a6c73; --line: #e2e0da;
    --accent: #3f6a96; --accent-soft: #e5edf5; --warn-soft: #f6ead6; --warn: #8a5a12;
    --male: #4f7cac; --female: #d08a2e; --other: #8b8f98;
    --shadow: 0 6px 24px rgb(20 22 28 / .10), 0 1px 3px rgb(20 22 28 / .08);
    --radius: 12px;
    --serif: "Source Serif 4", Georgia, "Times New Roman", serif;
    --sans: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  :root[data-theme="dark"] {
    --bg: #111317; --surface: #181b21; --surface-2: #20242b; --fg: #e9eaee; --muted: #9a9ea8; --line: #2b3038;
    --accent: #8fb3d9; --accent-soft: #223246; --warn-soft: #3a2f1c; --warn: #e2b46a;
    --shadow: 0 8px 28px rgb(0 0 0 / .45), 0 1px 3px rgb(0 0 0 / .4);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--fg); font: 15px/1.55 var(--sans); }
  a { color: var(--accent); text-underline-offset: 2px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -0.005em; }
  .muted { color: var(--muted); }
  .small { font-size: 12.5px; }
  button, input, select { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
